<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PhotoRenamer.Desktop"
        x:Class="PhotoRenamer.Desktop.MainWindow"
        x:DataType="local:MainViewModel"
        Title="Photo Renamer" Width="800" Height="450"
        MinWidth="420" MinHeight="280">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LogSuccessBrush" Color="#17643F" />
                    <SolidColorBrush x:Key="LogErrorBrush" Color="#B42332" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LogSuccessBrush" Color="#77D6A2" />
                    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF9A9A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="{DynamicResource LogSuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
        <Label Grid.Row="0" Content="Folder" Target="{Binding #FolderPath}" Padding="0" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
              IsEnabled="{Binding !StartProcessingCommand.IsRunning}">
            <TextBox x:Name="FolderPath"
                     Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="Browse…" Click="BrowseFolder"
                    VerticalAlignment="Stretch" />
        </Grid>

        <CheckBox Grid.Row="2" Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}"
                  IsEnabled="{Binding !StartProcessingCommand.IsRunning}" />
        <TextBlock Grid.Row="3" Text="Activity log" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ListBox Grid.Row="4" ItemsSource="{Binding EventLog}" AutomationProperties.Name="Activity log"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:EventLogEntry">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,8,0,0">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <ProgressBar Value="{Binding CurrentProgress}" Maximum="{Binding ProgressMaximum}"
                             AutomationProperties.Name="Processing progress" />
                <TextBlock Text="{Binding ProgressDescription}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding ProgressDescription}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Rename files" Classes="accent"
                    Command="{Binding StartProcessingCommand}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
